{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenRune Web Editor",
  "version": "0.1.0",
  "identifier": "dev.openrune.web-editor",
  "build": {
    "frontendDist": "../.tauri-frontend",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run tauri:build:web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenRune Web Editor",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
